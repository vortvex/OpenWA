# Copy to .env on the target Mac mini; never commit .env or data/.
NODE_ENV=production
TZ=America/Santiago
BIND_HOST=127.0.0.1
API_PORT=2785
ENGINE_TYPE=baileys
DATABASE_TYPE=sqlite
DATABASE_SYNCHRONIZE=false
MAIN_DATABASE_SYNCHRONIZE=false
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
MCP_ENABLED=true
MCP_READONLY=true
AUTO_START_SESSIONS=true
BAILEYS_SYNC_FULL_HISTORY=false
BAILEYS_MARK_ONLINE_ON_CONNECT=false
CHAT_MEDIA_ARCHIVE_ENABLED=false
CHAT_MEDIA_ARCHIVE_OUTBOUND=false
ENABLE_SWAGGER=false
CSP_UPGRADE_INSECURE_REQUESTS=false
LOG_LEVEL=warn
